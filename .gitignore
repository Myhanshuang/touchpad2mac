# Build artifacts (regenerated by any `cargo build`/`cargo test`).
/target

# Workspace-local Cargo cache (created by a CARGO_HOME override; must not be
# delivered as source — M6 re-review cleanup).
/.cargo-home

# Editor/OS noise.
*.swp
.DS_Store

# Local DSH/API credentials. DeepSeek Harness may read project .env files;
# never commit operator credentials.
.env
